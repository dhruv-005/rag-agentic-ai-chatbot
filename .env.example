# copy this file to .env and fill in your values
# only groq api key is needed everything else is free and local

# get your free groq api key at https://console.groq.com
GROQ_API_KEY=gsk_put_your_key_here

# model settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=llama-3.1-8b-instant

# chromadb local storage
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=agentic_ai_rag

# retrieval settings
TOP_K_RESULTS=5
RELEVANCE_THRESHOLD=0.70
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# pdf source
PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
PDF_LOCAL_PATH=./data/Ebook-Agentic-AI.pdf

# api server
API_HOST=0.0.0.0
API_PORT=8000
