# copy this to .streamlit/secrets.toml for local use
# on streamlit cloud add these in the secrets manager

GROQ_API_KEY = "gsk_your_key_here"
EMBEDDING_MODEL = "BAAI/bge-small-en-v1.5"
LLM_MODEL = "llama-3.1-8b-instant"
CHROMA_PERSIST_DIR = "./data/chroma_db"
CHROMA_COLLECTION_NAME = "agentic_ai_rag"
TOP_K_RESULTS = "5"
RELEVANCE_THRESHOLD = "0.70"
CHUNK_SIZE = "700"
CHUNK_OVERLAP = "100"
PDF_URL = "https://konverge.ai/pdf/Ebook-Agentic-AI.pdf"
PDF_LOCAL_PATH = "./data/Ebook-Agentic-AI.pdf"
API_HOST = "0.0.0.0"
API_PORT = "8000"
